{
  "name": "invoiceflow-ksa",
  "version": "1.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "check": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "test": "vitest run",
    "export:android": "expo export --platform android",
    "supabase:push": "supabase db push",
    "supabase:deploy": "supabase functions deploy extract-invoice && supabase functions deploy sheets && supabase functions deploy sheets-callback --no-verify-jwt && supabase functions deploy delete-account",
    "build:android": "eas build --profile production --platform android",
    "build:ios": "eas build --profile production --platform ios",
    "submit:android": "eas submit --profile production --platform android --latest",
    "submit:ios": "eas submit --profile production --platform ios --latest"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans-arabic": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.8.12",
    "@react-navigation/elements": "^2.9.2",
    "@react-navigation/native": "^7.1.25",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~54.0.37",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "^1.0.10",
    "expo-camera": "^17.0.10",
    "expo-constants": "~18.0.14",
    "expo-document-picker": "^14.0.8",
    "expo-file-system": "^19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "^17.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "^14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-text-extractor": "^2.0.0",
    "expo-web-browser": "~15.0.11",
    "fflate": "^0.8.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-mobile-ads": "^16.0.0",
    "react-native-reanimated": "~4.1.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.5.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "@types/react": "~19.1.17",
    "babel-preset-expo": "~54.0.6",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.7.4",
