# Copy to `.env` for local development. Never commit `.env`.
# For EAS builds, set the same EXPO_PUBLIC_* values with:
#   eas env:create --environment production --name EXPO_PUBLIC_SUPABASE_URL --value ... --visibility plaintext

# --- Supabase (public values; data is protected by Row Level Security) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- Smart reading with Claude (paid per invoice). "off" = free on-device reading
# (Saudi QR + OCR). Turn "on" only after setting ANTHROPIC_API_KEY on the server.
EXPO_PUBLIC_AI_EXTRACTION=off

# --- AdMob ad units (public identifiers, from admob.google.com) ---
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=ca-app-pub-2689118284753908/6316280227
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=

# --- AdMob app IDs (read by app.config.ts at build time) ---
ADMOB_ANDROID_APP_ID=ca-app-pub-2689118284753908~5629884518
ADMOB_IOS_APP_ID=

# -------------------------------------------------------------------------
# Server secrets — DO NOT put these here. Set them only in Supabase:
#   supabase secrets set ANTHROPIC_API_KEY=... TOKEN_ENCRYPTION_KEY=... \
#     GOOGLE_CLIENT_ID=... GOOGLE_CLIENT_SECRET=... \
#     SHEETS_REDIRECT_URI=https://YOUR-PROJECT-REF.supabase.co/functions/v1/sheets-callback
# Optional: CLAUDE_MODEL, GUEST_MONTHLY_SCANS (default 10), FREE_MONTHLY_SCANS (default 40), PRO_MONTHLY_SCANS (default 2000), APP_WEB_ORIGIN
# -------------------------------------------------------------------------
